# ==============================================================================
# Pulse Crisis Response — Backend Environment Configuration Template
# Copy this file to '.env' and fill in the values to transition from
# simulation mode to real-time production mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' or 'development'
PULSE_ENV=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. CURRENT ACTIVE CONFIGURATIONS
# ------------------------------------------------------------------------------
# Provide your Google Gemini API key to enable live Gemini Flash/Pro model calls
# instead of offline deterministic mocks for classification rationales and translations.
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Override default OTP bypass for local testing. If set, login requires this OTP.
PULSE_DEMO_OTP=654321

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PROPOSED PRODUCTION UPGRADE)
# ------------------------------------------------------------------------------
# Default is local SQLite 'pulse.db'. For production, uncomment and set
# a PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@localhost:5432/pulse_db

# ------------------------------------------------------------------------------
# 4. WEATHER INGESTION API (weather-agent)
# ------------------------------------------------------------------------------
# Set the weather API mode ('live' to use OpenWeatherMap, 'cache' for fallbacks)
WEATHER_API_MODE=cache
# OpenWeatherMap API Key for live weather metrics and alert thresholds (heavy rain, heat index)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
# Coordinates or city configuration for weather pooling (default: Islamabad)
OPERATIONAL_LATITUDE=33.6844
OPERATIONAL_LONGITUDE=73.0479

# ------------------------------------------------------------------------------
# 5. TRAFFIC INGESTION API (traffic-agent)
# ------------------------------------------------------------------------------
# Mapbox Access Token to read traffic congestion metrics on primary corridors
MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijo...your_mapbox_token_here

# ------------------------------------------------------------------------------
# 6. SOCIAL MEDIA INGESTION API (social-agent)
# ------------------------------------------------------------------------------
# Twitter/X API v2 Credentials for live keyword matching in Pakistani cities
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ------------------------------------------------------------------------------
# 7. SMS & COMMUNICATOR GATEWAY (stakeholder-comms)
# ------------------------------------------------------------------------------
# Configuration for sending bilingual alerts to citizens via SMS (Twilio or local Pakistan SMS)
SMS_PROVIDER=twilio # 'twilio' or 'jazz' or 'telenor'
TWILIO_ACCOUNT_SID=AC...your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SENDER_NUMBER=+1234567890

# Local Pakistani carrier APIs (if SMS_PROVIDER is 'jazz' or 'telenor')
LOCAL_SMS_API_URL=https://api.localcarrier.pk/send
LOCAL_SMS_API_KEY=your_local_sms_gateway_key

# ------------------------------------------------------------------------------
# 8. PUSH NOTIFICATIONS GATEWAY
# ------------------------------------------------------------------------------
# Path to the Firebase Admin SDK Service Account JSON for push alerts to Citizen & Responder apps
FIREBASE_SERVICE_ACCOUNT_PATH=deploy/firebase-service-account.json
FCM_ALERT_TOPIC=pulse-public-alerts

# ------------------------------------------------------------------------------
# 9. IoT / SENSOR INGESTION (sensor-agent)
# ------------------------------------------------------------------------------
# MQTT Broker connection credentials for real-time sensor streams (water levels, AQI, smoke)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=pulse_sensors
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_PREFIX=pulse/sensors/
